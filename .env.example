# Gemini on Vertex AI. No API key: the server signs in with Application Default
# Credentials on a laptop (gcloud auth application-default login) and with the
# App Hosting service account in production.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Firebase web config, from Project settings > Your apps > Web in the Firebase
# console. These are NOT secrets: they are public project identifiers and they
# ship in the browser bundle of every Firebase web app. Firestore security
# rules are what protect the data, not these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# GA4 Measurement ID (G-XXXXXXXXXX), loaded on /waitlist only. Optional: when
# blank, GA simply does not load. Not a secret. For production it goes in
# apphosting.yaml with BUILD and RUNTIME availability, because NEXT_PUBLIC_
# values are baked into the page when it is built.
NEXT_PUBLIC_GA_ID=
