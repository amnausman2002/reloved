rules_version = '2';

// Firestore security rules for Reloved.
//
// These are the real permission boundary. The app's buttons are a convenience;
// anyone can open a console and talk to Firestore directly with the public web
// config, so whatever is allowed here is allowed full stop.
//
// The shape follows the PRD:
//   - Browse shows live listings only, and needs no account at all.
//   - Listings and their status are written only by the server (Admin SDK),
//     which bypasses these rules entirely. So the rules below say "nobody",
//     and that is correct, not an oversight.
//   - An admin is a user with is_admin true. There is no role field.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own user document. Costs one read per call, which at
    // two admins is not worth optimising away.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // The fields a user is never allowed to set on herself. is_admin is the
    // dangerous one: without this, anyone could promote herself and start
    // approving listings. phone_verified_at matters too, because Amna and
    // Bismah now set it by hand after checking the number on WhatsApp, so a
    // seller writing it herself would skip the only check there is.
    function noPrivilegedFields() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['is_admin', 'phone_verified_at', 'email_verified_at']);
    }

    match /users/{userId} {
      // She reads her own record, and we read anyone's. Nobody else reads
      // anything.
      //
      // This was `if true` for a few hours on 12 Oct, on the reasoning that a
      // seller's display name and city are public anyway. That was wrong: a
      // user document also holds her email and her phone number, and Firestore
      // rules cannot hide individual fields. Anyone who knew the project id,
      // which ships in the browser bundle of every Firebase web app, could
      // list the whole collection over the REST API and walk off with every
      // seller's phone number. Verified by doing exactly that.
      //
      // The public profile page needs display_name, city, bio and avatar_url.
      // Those are served from the server with the Admin SDK, which picks the
      // safe fields explicitly, rather than by opening the document up here.
      allow read: if isSelf(userId) || isAdmin();

      // She creates her own record at sign-up, and can never grant herself
      // admin or mark her own phone verified.
      allow create: if isSelf(userId)
        && request.resource.data.is_admin == false
        && request.resource.data.phone_verified_at == null;

      allow update: if (isSelf(userId) && noPrivilegedFields()) || isAdmin();

      // Nobody deletes a user from the browser. Deleting one would orphan her
      // listings and every ContactEvent that counts toward the week 3 metric.
      allow delete: if false;
    }

    match /listings/{listingId} {
      // Browse needs no account, so live listings are public. A seller sees
      // her own at any status, and so does an admin.
      allow read: if resource.data.status == 'live'
        || isSelf(resource.data.seller_id)
        || isAdmin();

      // Written only by the server. The Admin SDK ignores these rules, so a
      // listing can still be created at submit; what this blocks is a browser
      // writing status 'live' and skipping the queue entirely.
      allow create, update, delete: if false;
    }

    match /photos/{photoId} {
      // Served with the listing, from the server, never read from a browser.
      //
      // This was `if true` on 12 Oct, reasoning that a photo URL is not a
      // secret. That holds for fetching a photo you already know about, but
      // not for listing the collection, which anyone could do: every photo
      // ever written, including listings still pending review, ones we
      // rejected, and ones auto-hidden after two reports. Plus quality_flags,
      // which is the AI's private opinion of a seller's photography.
      //
      // The images themselves stay publicly fetchable by URL, per
      // storage.rules. That is deliberate and normal: browse has to show them
      // to people with no account. What is closed here is enumeration.
      allow read: if false;
      allow write: if false;
    }

    match /contact_events/{eventId} {
      // The week 3 success metric. A buyer must never see how many people
      // contacted a seller, and a seller sees only her own listings' counts,
      // so this is admin-only on read and server-only on write. The daily
      // limit of 10 per buyer is enforced on the server, not here: rules
      // cannot count documents.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /moderation_actions/{actionId} {
      // Append-only, and only ever written by the server. Readable by us so
      // the history of why something was rejected is visible in the queue.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      // A report is created through the server too, so it can count existing
      // reports and auto-hide at two. A browser cannot do that safely.
      allow write: if false;
    }

    // Anything not named above is denied. New collections have to be added
    // here deliberately.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
