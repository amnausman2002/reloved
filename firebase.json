{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "reloved",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".env.local",
        ".claude",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "auth-variations.html",
        "https:",
        "install",
        "plugin",
        "tsconfig.tsbuildinfo",
        "exports"
      ]
    }
  ]
}
